### ==============================================================
### FDE Platform - REST Client API Tests (Week 1, 2, 3, 4)
### ==============================================================

@baseUrl = http://localhost:8000/api/v1

### 1. Health Checks
GET http://localhost:8000/health HTTP/1.1

###
GET {{baseUrl}}/health HTTP/1.1

### 2. User Registration
# @name register
POST {{baseUrl}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "lead.fde@googlecloud.com",
  "password": "Password123!",
  "full_name": "Lead Forward Deployed Engineer"
}

### 3. User Login
# @name login
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "lead.fde@googlecloud.com",
  "password": "Password123!"
}

### Save Token from login response
@authToken = {{login.response.body.access_token}}

### 4. Get Current User Profile
GET {{baseUrl}}/auth/me HTTP/1.1
Authorization: Bearer {{authToken}}

### 5. Create Enterprise Workspace
# @name createWorkspace
POST {{baseUrl}}/workspaces/ HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Acme Global Systems",
  "description": "Production workspace for Google Cloud FDE readiness assessment"
}

### Save Workspace ID
@workspaceId = {{createWorkspace.response.body.id}}

### 6. Create Project in Workspace
# @name createProject
POST {{baseUrl}}/projects/ HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "workspace_id": "{{workspaceId}}",
  "name": "Enterprise Knowledge Microservice",
  "description": "Customer microservice candidate for Cloud Run migration"
}

### Save Project ID
@projectId = {{createProject.response.body.id}}

### 7. Run Deterministic Diagnostics
# @name runDiagnostics
POST {{baseUrl}}/projects/{{projectId}}/diagnose HTTP/1.1
Authorization: Bearer {{authToken}}

### 8. List Project Findings
GET {{baseUrl}}/projects/{{projectId}}/findings HTTP/1.1
Authorization: Bearer {{authToken}}

### 9. Filter Findings by Severity
GET {{baseUrl}}/projects/{{projectId}}/findings?severity=high HTTP/1.1
Authorization: Bearer {{authToken}}

### 10. Update Finding Status
PATCH {{baseUrl}}/findings/YOUR_FINDING_ID/status HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "status": "acknowledged"
}

### 11. Trigger Data Readiness Assessment
# @name triggerReadiness
POST {{baseUrl}}/projects/{{projectId}}/data-readiness HTTP/1.1
Authorization: Bearer {{authToken}}

### 12. Get Latest Data Readiness Report
GET {{baseUrl}}/projects/{{projectId}}/data-readiness HTTP/1.1
Authorization: Bearer {{authToken}}

### 13. List Document Chunks
GET {{baseUrl}}/projects/{{projectId}}/chunks?limit=50&offset=0 HTTP/1.1
Authorization: Bearer {{authToken}}

### 14. Get Executive Production Readiness Audit Report (JSON)
GET {{baseUrl}}/projects/{{projectId}}/report HTTP/1.1
Authorization: Bearer {{authToken}}

### 15. Download Executive Audit Report (Markdown)
GET {{baseUrl}}/projects/{{projectId}}/report/download?format=markdown HTTP/1.1
Authorization: Bearer {{authToken}}

### 16. Download Executive Audit Report (JSON)
GET {{baseUrl}}/projects/{{projectId}}/report/download?format=json HTTP/1.1
Authorization: Bearer {{authToken}}

### 17. Trigger Multi-Agent Reasoning (Discovery Specialist)
# @name agentReasonDiscovery
POST {{baseUrl}}/projects/{{projectId}}/agents/reason HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "agent_type": "discovery",
  "custom_instruction": "Evaluate microservice topology and ingress endpoints"
}

### 18. Trigger Multi-Agent Reasoning (Security Reviewer)
# @name agentReasonSecurity
POST {{baseUrl}}/projects/{{projectId}}/agents/reason HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "agent_type": "security",
  "custom_instruction": "Assess CVSS severity of container defects and secrets"
}

### 19. Trigger Multi-Agent Reasoning (Deployment Planner)
# @name agentReasonDeployment
POST {{baseUrl}}/projects/{{projectId}}/agents/reason HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "agent_type": "deployment_planner",
  "custom_instruction": "Provide gcloud Cloud Run deploy commands and Secret Manager bindings"
}

### 20. List Agent Execution History
GET {{baseUrl}}/projects/{{projectId}}/agents/history HTTP/1.1
Authorization: Bearer {{authToken}}

### 21. Trigger 4-Agent Collaborative Pipeline (Discovery -> Security -> Data -> Deployment)
# @name agentPipeline
POST {{baseUrl}}/projects/{{projectId}}/agents/pipeline HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "custom_instruction": "Generate production-grade Terraform and automated diff patches"
}

### 22. Inspect Agent Blackboard & Memory Bus
GET {{baseUrl}}/projects/{{projectId}}/agents/memory HTTP/1.1
Authorization: Bearer {{authToken}}

### 23. Publish / Inject Memory Constraint to Bus
POST {{baseUrl}}/projects/{{projectId}}/agents/memory HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "key": "enterprise_target_region",
  "value": {
    "region": "asia-south1",
    "vpc_connector": "projects/my-enterprise/locations/asia-south1/connectors/fde-conn",
    "enforce_vpc_egress": "all-traffic"
  },
  "source_agent": "human_supervisor",
  "confidence": 1.0
}

### 24. Clear Agent Blackboard Bus
DELETE {{baseUrl}}/projects/{{projectId}}/agents/memory HTTP/1.1
Authorization: Bearer {{authToken}}

### 25. Submit Human-in-the-Loop Feedback (Approve / Reject / Modify)
# @name submitWorkbenchFeedback
POST {{baseUrl}}/projects/{{projectId}}/workbench/feedback HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "target_type": "patch",
  "action": "approve",
  "original_content": "--- a/requirements.txt\n+++ b/requirements.txt\n@@ -1,2 +1,2 @@\n-fastapi\n+fastapi==0.115.0\n",
  "reviewer_comments": "Approved after staging environment vulnerability scan."
}

### 26. List Human-in-the-Loop Audit & Feedback History
GET {{baseUrl}}/projects/{{projectId}}/workbench/feedback HTTP/1.1
Authorization: Bearer {{authToken}}

### 27. Apply Verified Remediation Patch to Project Code
# @name applyRemediationPatch
POST {{baseUrl}}/projects/{{projectId}}/workbench/apply-patch HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "patch_content": "--- a/requirements.txt\n+++ b/requirements.txt\n@@ -1,4 +1,4 @@\n-fastapi\n-uvicorn\n+fastapi==0.115.0\n+uvicorn==0.30.6\n",
  "reviewer_comments": "Applying production dependency pins via Human Workbench"
}
