### ==============================================================
### FDE Platform - REST Client API Tests (Week 1 & 2)
### ==============================================================

@baseUrl = http://localhost:8000/api/v1

### 1. Health Checks
GET http://localhost:8000/health HTTP/1.1

###
GET {{baseUrl}}/health HTTP/1.1

### 2. User Registration
# @name register
POST {{baseUrl}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "engineer@acme.com",
  "password": "Password123!",
  "full_name": "Senior Forward Deployed Engineer"
}

### 3. User Login
# @name login
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "engineer@acme.com",
  "password": "Password123!"
}

### Save Token from login response
@authToken = {{login.response.body.access_token}}

### 4. Get Current User Profile
GET {{baseUrl}}/auth/me HTTP/1.1
Authorization: Bearer {{authToken}}

### 5. Create Enterprise Workspace
# @name createWorkspace
POST {{baseUrl}}/workspaces/ HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Acme Global Systems",
  "description": "Production workspace for Google Cloud FDE readiness assessment"
}

### Save Workspace ID
@workspaceId = {{createWorkspace.response.body.id}}

### 6. List User Workspaces
GET {{baseUrl}}/workspaces/ HTTP/1.1
Authorization: Bearer {{authToken}}

### 7. Create Project in Workspace
# @name createProject
POST {{baseUrl}}/projects/ HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "workspace_id": "{{workspaceId}}",
  "name": "Acme Knowledge Assistant",
  "description": "Enterprise multi-agent assistant with RAG pipelines",
  "repository_url": "https://github.com/acme/knowledge-assistant"
}

### 8. List Projects in Workspace
GET {{baseUrl}}/projects/?workspace_id={{workspaceId}} HTTP/1.1
Authorization: Bearer {{authToken}}
