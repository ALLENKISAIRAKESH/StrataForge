### ==============================================================
### FDE Platform - REST Client API Tests (Week 1, 2, 3, 4)
### ==============================================================

@baseUrl = http://localhost:8000/api/v1

### 1. Health Checks
GET http://localhost:8000/health HTTP/1.1

###
GET {{baseUrl}}/health HTTP/1.1

### 2. User Registration
# @name register
POST {{baseUrl}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "lead.fde@googlecloud.com",
  "password": "Password123!",
  "full_name": "Lead Forward Deployed Engineer"
}

### 3. User Login
# @name login
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "lead.fde@googlecloud.com",
  "password": "Password123!"
}

### Save Token from login response
@authToken = {{login.response.body.access_token}}

### 4. Get Current User Profile
GET {{baseUrl}}/auth/me HTTP/1.1
Authorization: Bearer {{authToken}}

### 5. Create Enterprise Workspace
# @name createWorkspace
POST {{baseUrl}}/workspaces/ HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Acme Global Systems",
  "description": "Production workspace for Google Cloud FDE readiness assessment"
}

### Save Workspace ID
@workspaceId = {{createWorkspace.response.body.id}}

### 6. Create Project in Workspace
# @name createProject
POST {{baseUrl}}/projects/ HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "workspace_id": "{{workspaceId}}",
  "name": "Enterprise Knowledge Microservice",
  "description": "Customer microservice candidate for Cloud Run migration"
}

### Save Project ID
@projectId = {{createProject.response.body.id}}

### 7. Run Deterministic Diagnostics
# @name runDiagnostics
POST {{baseUrl}}/projects/{{projectId}}/diagnose HTTP/1.1
Authorization: Bearer {{authToken}}

### 8. List Project Findings
GET {{baseUrl}}/projects/{{projectId}}/findings HTTP/1.1
Authorization: Bearer {{authToken}}

### 9. Filter Findings by Severity
GET {{baseUrl}}/projects/{{projectId}}/findings?severity=high HTTP/1.1
Authorization: Bearer {{authToken}}

### 10. Update Finding Status
PATCH {{baseUrl}}/findings/YOUR_FINDING_ID/status HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "status": "acknowledged"
}

### 11. Trigger Data Readiness Assessment
# @name triggerReadiness
POST {{baseUrl}}/projects/{{projectId}}/data-readiness HTTP/1.1
Authorization: Bearer {{authToken}}

### 12. Get Latest Data Readiness Report
GET {{baseUrl}}/projects/{{projectId}}/data-readiness HTTP/1.1
Authorization: Bearer {{authToken}}

### 13. List Document Chunks
GET {{baseUrl}}/projects/{{projectId}}/chunks?limit=50&offset=0 HTTP/1.1
Authorization: Bearer {{authToken}}

### 14. Get Executive Production Readiness Audit Report (JSON)
GET {{baseUrl}}/projects/{{projectId}}/report HTTP/1.1
Authorization: Bearer {{authToken}}

### 15. Download Executive Audit Report (Markdown)
GET {{baseUrl}}/projects/{{projectId}}/report/download?format=markdown HTTP/1.1
Authorization: Bearer {{authToken}}

### 16. Download Executive Audit Report (JSON)
GET {{baseUrl}}/projects/{{projectId}}/report/download?format=json HTTP/1.1
Authorization: Bearer {{authToken}}
